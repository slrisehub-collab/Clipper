# ---------------------------------------------------------------------------
# ClipForge configuration. Copy to .env and fill in. Shared by web and worker.
# ---------------------------------------------------------------------------

# Public URL of the web app (used for share links and secure cookies when https).
APP_URL=http://localhost:3000
# Docker Compose only: the address Caddy serves. A domain gets automatic HTTPS; ":80" serves plain HTTP.
SITE_ADDRESS=:80

# PostgreSQL 14+. Free options: self-hosted, Neon, or any VPS.
DATABASE_URL=postgres://clipforge:clipforge@localhost:5432/clipforge
# Set to true for hosted databases that require TLS (Neon etc.).
DATABASE_SSL=false

# Redis 6+ for the BullMQ job queue and rate limiting.
REDIS_URL=redis://localhost:6379

# Random secret, at least 32 characters. Signs file and upload URLs.
# Generate one with: openssl rand -base64 48
SIGNING_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Storage: "local" (files on disk, web + worker must share the directory)
# or "s3" (any S3-compatible bucket: Cloudflare R2, Backblaze B2, MinIO, AWS).
STORAGE_DRIVER=local
STORAGE_DIR=./data/storage

# Only used when STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Worker scratch space for FFmpeg (needs free space of roughly 2x your largest video).
WORK_DIR=./data/tmp
# How many clipping jobs one worker runs at once. FFmpeg already uses all cores per job.
WORKER_CONCURRENCY=1
# Optional: cap FFmpeg threads per process (0 = FFmpeg decides).
FFMPEG_THREADS=0
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Set to false to close public sign-ups.
ALLOW_REGISTRATION=true
# Shown on the help page.
SUPPORT_EMAIL=

# DANGER: lets URL import reach private/local addresses. Only for local testing.
UNSAFE_ALLOW_PRIVATE_URLS=false
